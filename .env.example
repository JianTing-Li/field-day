# Copy to .env.local and fill in your own values. Never commit .env.local.
# All of these are read only in server code. Never prefix secrets with NEXT_PUBLIC_.

# Anthropic API key (each developer uses their own)
ANTHROPIC_API_KEY=

# Anthropic model ID (defaults to claude-haiku-5-5 if unset)
ANTHROPIC_MODEL=claude-haiku-5-5

# AirNow API key (live air quality only)
AIRNOW_API_KEY=

# NWS requires an identifying User-Agent, e.g. "FieldDay (you@example.com)"
NWS_USER_AGENT=

# fixture (default) or live
FIELDDAY_DATA_MODE=fixture
